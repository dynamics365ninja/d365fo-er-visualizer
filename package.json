{
  "name": "d365fo-er-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Visual designer and analyzer for D365FO Electronic Reporting configurations",
  "scripts": {
    "dev": "pnpm --filter @er-visualizer/ui dev",
    "dev:electron": "pnpm --filter @er-visualizer/electron dev",
    "dev:site": "pnpm --filter @er-visualizer/site dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @er-visualizer/site build:all",
    "test": "pnpm --filter @er-visualizer/core test && pnpm --filter @er-visualizer/fno-client test && pnpm --filter @er-visualizer/ui test",
    "test:watch": "pnpm --filter @er-visualizer/core test:watch",
    "test:integration": "tsx scripts/integration-test.ts",
    "lint": "pnpm -r --filter './packages/*' lint"
  },
  "devDependencies": {
    "@azure/msal-node": "^3.2.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
