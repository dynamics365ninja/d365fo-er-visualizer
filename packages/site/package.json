{
  "name": "@er-visualizer/site",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site and user documentation for D365FO ER Visualizer",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "stage:app": "node ../../scripts/stage-app.mjs",
    "build:app": "APP_BASE=/app/ pnpm --filter @er-visualizer/ui build",
    "build:all": "pnpm run build:app && pnpm run stage:app && pnpm run build"
  },
  "dependencies": {
    "@er-visualizer/design-tokens": "workspace:*",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.4.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
